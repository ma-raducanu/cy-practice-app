  "main": "index.js",
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "cypress-regression": "npx cypress run",
    "cypress-regression-chrome": "npx cypress run --browser chrome",
    "cypress-regression-edge": "npx cypress run --browser edge",
    "cypress-regression-all": "npm-run-all -p cypress-regression cypress-regression-chrome cypress-regression-edge",
    "cypress-smoke": "npx cypress run --spec 'cypress/e2e/1st-test.cy.js'",
