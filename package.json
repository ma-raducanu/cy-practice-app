    "cypress-smoke-edge": "npx cypress run --spec 'cypress/e2e/1st-test.cy.js' --browser edge",
    "cypress-smoke-all": "npm-run-all -p cypress-smoke cypress-smoke-chrome cypress-smoke-edge"
  },
  "devDependencies": {
    "cypress": "^15.21.1",
    "cypress-iframe": "^1.0.1",
    "npm-run-all": "^4.1.5"
  }
